option('tests', type: 'feature', description: 'Build tests')
option('intel-pfr', type: 'feature', description: 'Intel Platform Firmware Resilience enabled')
option('bmc-validation-unsecure-feature', type: 'feature', description: 'Enables unsecure features required by validation. Note: must be turned off for production images.')
option('using-entity-manager-decorators', type: 'feature', description: 'Enable using EM decorators to map FRUs to entity IDs')
option('non-intel-platforms' , type: 'feature', value: 'disabled', description: 'If non-intel platforms disable the get chassis power status handler.')
option('ipmi-firewall', type: 'boolean',value:false, description: 'ipmi-firewall will only restrict the inband from getting executed and will not restrict outband IPMI commands which are not in allowlist file')
option('disable-special-mode', type:'boolean', value: false,description: 'Disable special mode provisioning by enabling the disable-special-mode option.')
option('configurable-fru', type: 'boolean', value:false, description: 'Configurable FRU  Support by enabling and disabling the configurable-fru option',)
option('apisensor', type: 'feature', value: 'disabled', description: 'Enables APISensor Support.',)
option('static-sensor-number', type: 'feature', value: 'disabled', description: 'Enable static sensor number support, reads sensor number from sensor.value dbus interface')
option('redfish-map-path', type: 'string', value: '/usr/share/intel-ipmi-oem/sel_redfish_map.json', description: 'Path to the IPMI->Redfish SEL message map JSON file installed on the BMC.')
